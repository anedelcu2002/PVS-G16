Soort = 'XW6848';
PV = 'Longi';
P_dc = readtable("Final_8760_Generation.xlsx");

	
switch Soort
    case 'XW6848'
        A = 6.75776E+03;
        B = 4.2E+01;
        C = -1.2E-05;		
        Vdc = 48;
        P_ac0 = 6.12E+03;
        fprintf('Inverter type is XW6848 \n')
    case 'SW4024'
        A = 3.655E+03;
    	B = 4.2E+01;
        C = -1.2E-05;
        Vdc = 24;
        P_ac0 = 3.4E+03;
        fprintf('Inverter type is SW4024 \n')
    case 'SW4048'
        A = 4.086+03;
        B = 4.2E+01;
        C = -1.2E-05;
        Vdc = 48;
        P_ac0 = 3.8E+03;
        fprintf('Inverter type is SW4048 \n')
    otherwise    
        disp('No inverter type was chosen')
end

switch PV
    case 'Longi'
        P_dc = readtable("Final_8760_Generation.xlsx");
        P_dc(2:8760,2);
        P_in=table2array(ans);
    	disp ('Panel type is Longi')
    case 'Aiko'
        P_dc = readtable("Final_8760_Generation.xlsx");
        P_dc(2:8760,3);
        disp ('Panel type is Aiko')
        P_in=table2array(ans);
    otherwise
        disp('No module was chosen')
end

 P_ac = ((P_ac0/(A-B))-C*(A-B))*(P_in-B)+C*power((P_in-B),2);






